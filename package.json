{
  "name": "local-events-assets",
  "private": true,
  "scripts": {
    "build:assets": "npm run build:css && npm run build:js",
    "build:css": "cleancss -O2 -o web/css/styles.min.css web/css/styles.css",
    "build:js": "terser web/js/main.js --compress --mangle --output web/js/main.min.js"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "terser": "^5.44.0"
  }
}
